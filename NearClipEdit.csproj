<Project Sdk="Microsoft.NET.Sdk">

  <!--
    独立插件：Near Clip Edit（只改平面模式主相机的 near clip plane）
    编译：
      export DOTNET_ROOT="<工作区>/05_工具链/dotnet"
      dotnet build -c Release -p:GameDir="I:/Koikatu"
    产物：bin/Release/NearClipEdit.dll → 丢到 BepInEx/plugins/
    注意：本工程**不引用任何游戏程序集**（只有 UnityEngine + BepInEx），
          所以同一个 DLL 在 Koikatu.exe / KoikatuVR.exe / CharaStudio.exe 都能跑。
  -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">I:/Koikatu</GameDir>

    <TargetFramework>net35</TargetFramework>
    <AssemblyName>NearClipEdit</AssemblyName>
    <RootNamespace>NearClipEdit</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Company 会被写进 DLL 的文件版本信息；ConfigurationManager（F1）会读它，
         把这里填成仓库地址，插件页右上角就会出现一个 URL 按钮，点开就是本仓库。 -->
    <Company>https://github.com/HanYuanyi/NearClipEdit</Company>
    <Description>NearClipEdit - Koikatu CharaStudio 插件</Description>
    <AssemblyTitle>NearClipEdit</AssemblyTitle>
    <Product>Near Clip Edit</Product>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin/**/*.cs" />
    <Compile Remove="obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\CharaStudio_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
